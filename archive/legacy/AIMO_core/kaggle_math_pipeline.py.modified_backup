# --- Solver (full-ish, adapated) ---
class LocalLLMClient:
    def __init__(self, model_name=None, quantization=None):
        self.model_name = model_name
        self.quantization = quantization
        # Attempt to initialize Tensor/transformers clients lazily
        self.tokenizer = None
        self.model = None
        self.pipeline = None
    def _get_tokenizer(self, model_name):
        try:
            from transformers import AutoTokenizer
            tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
            if tokenizer.pad_token is None:
                tokenizer.pad_token = tokenizer.eos_token
            return tokenizer
        except Exception:
            return None
    def _get_model(self):
        try:
            from transformers import AutoModelForCausalLM, BitsAndBytesConfig
            import torch
            quant_cfg = None
            if self.quantization == '4bit':
                quant_cfg = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type='nf4', bnb_4bit_compute_dtype=torch.float16)
            model = AutoModelForCausalLM.from_pretrained(self.model_name, device_map='auto', trust_remote_code=True, quantization_config=quant_cfg)
            return model
        except Exception:
            return None
    def _get_pipeline(self):
        try:
            from transformers import pipeline
            if self.pipeline is None:
                self.pipeline = pipeline('text-generation', model=self._get_model(), tokenizer=self._get_tokenizer(self.model_name), device_map='auto')
            return self.pipeline
        except Exception:
            return None
    def generate(self, prompt: str) -> str:
        try:
            pipe = self._get_pipeline()
            if not pipe:
                # fallback: return a minimal code response
                return "```python\nprint('ERROR: LLM not available')\n```"
            outputs = pipe(prompt, max_new_tokens=512, do_sample=False, num_return_sequences=1)
            if outputs and isinstance(outputs, list) and len(outputs) > 0:
                out0 = outputs[0]
                if isinstance(out0, dict) and 'generated_text' in out0:
                    gen = out0['generated_text']
                else:
                    gen = str(out0)
                return gen
            return "```python\nprint('NO RESPONSE')\n```"
        except Exception as e:
            return f"```python\nprint('ERROR: {e}')\n```"

class Solver:
    def __init__(self):
        self.llm = LocalLLMClient()
        self.last_reasoning = None
        self.last_syntax_error = False
        self.last_complexity_score = None
    def _extract_code(self, response: str) -> str:
        # Extract code block
        match = re.search(r"```python\s*(.*?)\s*```", response, re.DOTALL)
        if match:
            code = match.group(1).strip()
        else:
            # naive extraction
            code = response.strip()
        # basic compile check
        try:
            compile(code, '<string>', 'exec')
            self.last_syntax_error = False
        except SyntaxError:
            self.last_syntax_error = True
            code = "print('ERROR: Code generation failed')"
        return code
    def generate_code(self, problem_text: str, strategy: str) -> str:
        complexity_score = assess_complexity(problem_text)
        self.last_complexity_score = complexity_score
        use_structured = config.USE_STRUCTURED and complexity_score >= config.COMPLEXITY_STRUCTURED_MIN_SCORE
        reasoning_text = None
        if use_structured:
            reasoning_prompt = build_refine_prompt(problem_text, None, None, 'reasoning_request', None, None)
            reasoning_text = self.llm.generate(reasoning_prompt)
            self.last_reasoning = reasoning_text
        else:
            self.last_reasoning = None
        lemma_snippets = [k for k,_ in GLOBAL_LEMMA_CACHE.top(5)] if GLOBAL_LEMMA_CACHE else []
        prompt = self._construct_prompt(problem_text, strategy, reasoning_text, lemma_snippets)
        response = self.llm.generate(prompt)
        code = self._extract_code(response)
        return code
    def generate_candidates(self, problem_text, strategy, num_candidates, temps):
        candidates = []
        for i in range(num_candidates):
            prompt = self._construct_prompt(problem_text, strategy, self.last_reasoning, [])
            gen = self.llm.generate(prompt)
            candidates.append(self._extract_code(gen))
        return candidates
    def generate_code_from_prompt(self, prompt):
        response = self.llm.generate(prompt)
        return self._extract_code(response)
    def _construct_prompt(self, problem_text, strategy, reasoning_text, lemma_snippets):
        base = f"Write Python code to solve the problem. Strategy: {strategy}.\nProblem: {problem_text}\nCode:"
        if reasoning_text:
            base = reasoning_text + '\n' + base
        if lemma_snippets:
            base = '\n'.join(lemma_snippets) + '\n' + base
        return base

