# --- lemma cache (minimal) ---
class _LemmaCache:
    def __init__(self):
        self._set = set()
        self.store = {}
    def add(self, item):
        if not item:
            return False
        s = str(item)
        if s in self._set:
            return False
        self._set.add(s)
        self.store[s] = self.store.get(s, 0) + 1
        return True
    def top(self, k: int = 10):
        return sorted(self.store.items(), key=lambda x: x[1], reverse=True)[:k]

GLOBAL_LEMMA_CACHE = _LemmaCache()

