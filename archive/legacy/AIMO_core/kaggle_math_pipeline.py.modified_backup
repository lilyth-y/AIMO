def extract_answer(reasoning_text: str):
    if not reasoning_text:
        return None
    m = re.search(r"\\boxed\{([^}]*)\}", reasoning_text)
    if m:
        return m.group(1).strip()
    m = re.search(r"(-?\\d+(?:\\.\\d+)?)", reasoning_text)
    return m.group(1) if m else None

