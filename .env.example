# 복사: copy .env.example .env   (또는 cp)
# 상세: docs/getting-started/LOCAL_LIGHT.md

# --- pytest 전체 (모의 솔버, 모델 없음) ---
AIMO_FAST_TEST=1
PYTHONPATH=src

# --- 로컬에서 소형 모델 실추론(CPU) 시 예시 (run_tests_fast와 동시 쓰지 말 것) ---
# AIMO_FAST_TEST=0
# OMI_MODEL=Qwen/Qwen2.5-Math-1.5B-Instruct
# OMI_QUANTIZATION=none
# AIMO_MAX_NEW_TOKENS=1024

# --- NVIDIA NIM (원격) + Qwen Math 7B Instruct ---
# 로컬 GPU/양자화를 쓰지 않고 원격 엔드포인트로 추론합니다.
# AIMO_FAST_TEST=0
# OMI_REMOTE_INFERENCE_PROVIDER=nvidia_nim
# NVIDIA_API_KEY=nvapi-xxxxxxxx
# OMI_NVIDIA_MODEL=Qwen/Qwen2.5-Math-7B-Instruct
# (선택) 기본 NIM URL 대신 게이트웨이/프록시를 쓸 때만 지정
# OMI_REMOTE_INFERENCE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# 의도/로그 일치용 (원격 추론 시 참고용 표기)
# OMI_MODEL=Qwen/Qwen2.5-Math-7B-Instruct
# OMI_QUANTIZATION=none

# 선택 — stage2를 더 줄일 때
# OMI_DISABLE_KNOWLEDGE_GROUND=1
# OMI_DISABLE_KNOWLEDGE_GROUND_RULES_FILE=1

# 관리형 RAG 기본 꺼짐
# AIMO_MANAGED_EMBEDDING_RAG=1
# AIMO_MANAGED_RAG_PROVIDER=vertex

# --- 대시보드 (dashboard/) 프론트엔드 ---
# Vite 개발 서버가 백엔드 API를 프록시할 때 사용하는 URL
# 로컬 기본값: http://localhost:8080 (생략 가능)
# Cloud Run 등 다른 환경에서는 실제 배포 URL로 변경하세요.
# VITE_API_URL=http://localhost:8080
# VITE_API_URL=https://your-cloud-run-service-url.run.app
